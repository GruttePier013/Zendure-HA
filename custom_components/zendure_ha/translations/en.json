    "step": {
      "init": {
        "title": "Zendure HA-GP013 settings",
        "description": "P1 sensor: {p1meter}\nToken: {token}\nMQTT: {mqtt}\nPower control (normal / fast): {control}\nSlew rate (up / down, direction change delay): {slew}\nLifetime: {lifetime}\nFixed device addresses: {addresses}\nMQTT logging: {logging}, simulation: {simulation}\n\nChoose the settings you want to change.",
