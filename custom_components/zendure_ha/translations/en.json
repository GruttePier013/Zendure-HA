        "data": {
          "mqttlocal": "Use local MQTT",
          "mqttserver": "MQTT Server",
          "mqttport": "MQTT Port",
          "mqttuser": "MQTT User",
          "mqttpsw": "MQTT Password",
          "auto_mqtt_user": "Automatically manage MQTT users",
          "wifissid": "Wifi SSID",
          "wifipsw": "Wifi Password"
        }
      },
      "p1_meter": {
        "title": "P1 meter",
        "description": "The sensor (in W) that reports the net power at the grid connection.",
        "data": {
          "p1meter": "P1 Sensor for smart matching"
        }
      },
      "power_control": {
        "title": "Power control",
        "description": "How fast and how sensitive the manager follows the P1 meter. Change with care: a shorter interval means more commands to the devices. The P1 meter itself is always followed quickly; the manual interval only applies to manual mode.",
        "data": {
          "time_zero": "Normal update interval (s)",
          "time_fast": "Fast update interval (s)",
          "p1_stddev_min": "Minimum P1 change (W)",
          "power_start": "Minimum power to start a device (W)",
          "power_tolerance": "Device power tolerance (W)",
          "manual_interval": "Update interval in manual mode (s)",
          "peak_limit": "Peak shaving limit (W, 0 = off)"
        }
      },
      "slew": {
        "title": "Slew rate & direction change",
        "description": "Limits how fast the commanded power changes, and always passes through 0 W (with a short pause) when switching between charging and discharging. This protects relays and inverter. Values are defaults and not firmware specifications. The device that is kept ready for peaks may start faster from standby; direction changes always use the normal rate.",
        "data": {
          "slew_enabled": "Limit the power change rate",
          "slew_up": "Maximum increase (W/s)",
          "slew_down": "Maximum decrease (W/s)",
          "flip_delay": "Pause at 0 W when changing direction (s)",
          "min_run": "Minimum run time of a started device (s)",
          "ready_rate": "Faster start of the device kept ready (W/s)"
        }
      },
      "lifetime": {
        "title": "Lifetime (flash & roles)",
        "description": "With several devices, one device discharges and another one charges. A role only moves to another device when it leads by this many SoC points and the role was held for at least 5 minutes. The safe state stores 0 W once in the device flash, so a device that reboots starts at 0 W; it is written at most once per hour. Charging and discharging use as few devices as needed: another device only starts when the running ones carry this share of their limit, the others stay ready for peaks such as a kettle.",
        "data": {
          "role_margin": "Role switch margin (SoC %)",
          "fill_level": "Load per device before another one starts (%)",
          "flash_safe_state": "Store the safe state (0 W) in device flash"
        }
      },
      "device_ips": {
        "title": "Device addresses",
        "description": "Fixed IP address or hostname per zenSDK device. It overrides the address from the cloud and from mDNS, which is useful across VLANs. Leave empty to detect it automatically.\n\n{devices}"
      },
      "diagnostics": {
        "title": "Logging & simulation",
        "description": "Debug options.",
        "data": {
          "mqttlog": "Log MQTT communication",
          "simulation": "Simulation mode"
        }
      }
