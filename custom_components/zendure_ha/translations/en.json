  "issues": {
    "zensdk_unreachable": {
      "title": "{name} does not respond",
      "description": "The Zendure device {name} ({address}) did not answer repeated local zenSDK requests. Check the power and Wi-Fi of the device, its IP address (Configure, Device addresses) and the network between Home Assistant and the device. The issue disappears when the device answers again."
    },
    "mqtt_cloud_disconnected": {
      "title": "Zendure cloud MQTT is not connected",
      "description": "Home Assistant is not connected to the Zendure cloud MQTT server {server}. Devices that depend on it cannot be controlled. Check your internet connection and the token. The issue disappears when the connection is restored."
    },
    "mqtt_local_disconnected": {
      "title": "Local MQTT broker is not connected",
      "description": "Home Assistant is not connected to the local MQTT server {server}. Check that the broker is running and that the user and password are correct. The issue disappears when the connection is restored."
    }
  }
