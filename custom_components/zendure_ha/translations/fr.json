        "data": {
          "p1meter": "Capteur P1 pour le couplage intelligent"
        }
      },
      "power_control": {
        "title": "Régulation de puissance",
        "description": "Rapidité et sensibilité avec lesquelles le gestionnaire suit le compteur P1. À modifier avec prudence : un intervalle plus court signifie plus de commandes envoyées aux appareils. Le compteur P1 lui-même est toujours suivi rapidement ; l'intervalle manuel ne s'applique qu'en mode manuel.",
        "data": {
          "time_zero": "Intervalle de mise à jour normal (s)",
          "time_fast": "Intervalle de mise à jour rapide (s)",
          "p1_stddev_min": "Variation P1 minimale (W)",
          "power_start": "Puissance minimale pour démarrer un appareil (W)",
          "power_tolerance": "Tolérance de puissance de l'appareil (W)",
          "manual_interval": "Intervalle de mise à jour en mode manuel (s)",
          "peak_limit": "Limite d'écrêtage des pics (W, 0 = désactivé)"
        }
      },
      "slew": {
        "title": "Slew rate et changement de sens",
        "description": "Limite la vitesse de variation de la puissance demandée et passe toujours par 0 W (avec une courte pause) lors du passage entre charge et décharge. Cela protège les relais et l'onduleur. Les valeurs sont des valeurs par défaut, pas des spécifications du fabricant. L'appareil prêt pour les pics peut démarrer plus vite depuis la veille ; un changement de sens utilise toujours la vitesse normale.",
        "data": {
          "slew_enabled": "Limiter la vitesse de variation de la puissance",
          "slew_up": "Augmentation maximale (W/s)",
          "slew_down": "Diminution maximale (W/s)",
          "flip_delay": "Pause à 0 W lors du changement de sens (s)",
          "min_run": "Durée de fonctionnement minimale d'un appareil démarré (s)",
          "ready_rate": "Démarrage plus rapide de l'appareil prêt (W/s)"
        }
      },
      "lifetime": {
        "title": "Durée de vie (flash et rôles)",
        "description": "Avec plusieurs appareils, l'un décharge et un autre charge. Un rôle ne passe à un autre appareil que si celui-ci a autant de points de SoC d'avance et que le rôle a été conservé au moins 5 minutes. L'état sûr enregistre une fois 0 W dans la mémoire flash de l'appareil, de sorte qu'un appareil qui redémarre commence à 0 W ; il est écrit au plus une fois par heure. La charge et la décharge utilisent le moins d'appareils possible : un autre appareil ne démarre que lorsque ceux en marche portent cette part de leur limite ; les autres restent prêts pour les pics, comme une bouilloire.",
        "data": {
          "role_margin": "Marge de changement de rôle (SoC %)",
          "fill_level": "Charge par appareil avant le démarrage d'un autre (%)",
          "flash_safe_state": "Enregistrer l'état sûr (0 W) dans la mémoire flash de l'appareil"
        }
      },
